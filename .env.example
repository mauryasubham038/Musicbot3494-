API_ID=
API_HASH=
BOT_TOKEN=
# Ek assistant: SESSION_STRING. Bade scale ke liye kai accounts (comma ya nayi line se alag):
SESSION_STRING=
SESSION_STRINGS=

# Admin panel (ADMIN_PASSWORD na doge to panel band rahega)
ADMIN_USER=admin
ADMIN_PASSWORD=
TIMEZONE=Asia/Kolkata
# Railway Volume /data par mount karo to stats + search cache redeploy ke baad bhi bachte hain
DB_PATH=/data/bot.db

# YouTube blocking se bachne ke liye (bade scale par zaroori): ek ya kai proxy, comma se alag
PROXY=
# Cookies (dummy Google accounts). Kai daal sakte ho: COOKIES_B64, COOKIES_B64_1, COOKIES_B64_2 ... (max _20)
# Panel me har cookie ka status dikhta hai. Blocked cookie COOKIE_COOLDOWN (default 1800s) aaram karti hai.
COOKIES_B64=
COOKIES_B64_1=
COOKIES_B64_2=

# Optional tuning (defaults theek hain)
# DL_CONCURRENCY=8        # ek saath kitne downloads (CPU/proxy ke hisaab se)
# MAX_DURATION=900        # seconds, isse lamba gaana reject
# MAX_FILESIZE_MB=80
# MAX_QUEUE=30
# MIN_ARTIST_SONGS=3      # radio me itne se kam gaane wale singer hide
# ALLOWED_DOMAINS=youtube.com,youtu.be,soundcloud.com

# /start screen: photo URL ya file_id (ya assets/start.jpg file rakh do) aur support group link
START_PHOTO=
SUPPORT_URL=
