# ================= ZAROORI (bina inke bot nahi chalega) =================
API_ID=
API_HASH=
BOT_TOKEN=
# Assistant account(s). Ek ho to SESSION_STRING, kai ho to SESSION_STRINGS (comma ya nayi line se alag)
SESSION_STRING=
SESSION_STRINGS=

# ================= /start SCREEN =================
START_PHOTO=
SUPPORT_URL=https://t.me/ZenithSsupport
# Update channel ka link (Update button). Khali rakho to button nahi dikhega
UPDATE_URL=

# ================= OWNER / STORAGE =================
# Apna Telegram user id (dead assistant wagairah ka private alert). Bot ko ek baar /start karna zaroori
OWNER_ID=
# Gaane yahan save hote hain (private channel, bot admin ho). Id aisi: -1001234567890
STORAGE_CHANNEL=

# ================= ADMIN PANEL =================
# ADMIN_PASSWORD khali = panel band
ADMIN_USER=admin
ADMIN_PASSWORD=
PORT=8080
TIMEZONE=Asia/Kolkata
# Railway Volume /data par mount karo to data redeploy ke baad bhi bachta hai
DB_PATH=/data/bot.db

# ================= YOUTUBE BLOCK SE BACHAV =================
# Proxy: ek ya kai (comma se alag)
PROXY=
# Cookies: COOKIES_B64, COOKIES_B64_1 ... COOKIES_B64_20 (ya COOKIES_TXT, COOKIES_TXT_1 ...)
COOKIES_B64=
COOKIES_B64_1=
COOKIES_B64_2=
COOKIES_TXT=
COOKIE_COOLDOWN=1800

# ================= DOWNLOAD / PLAYER (defaults theek hain) =================
DL_DIR=/tmp/tgm_audio
MAX_CACHE_MB=1500
MAX_DURATION=900
MAX_FILESIZE_MB=80
DL_CONCURRENCY=8
SEARCH_CONCURRENCY=8
ALLOWED_DOMAINS=youtube.com,youtu.be,soundcloud.com
MAX_QUEUE=30
PLAY_COOLDOWN=3
# 1 = pause/skip/stop/loop sirf admins
CONTROLS_ADMIN_ONLY=1
STALL_GRACE=20
MIN_ARTIST_SONGS=3

# ================= ASSISTANT / GROUP =================
# Itne din gaana na baje to assistant group chhod deta hai. 0 = kabhi nahi
IDLE_LEAVE_DAYS=30
# Assistant add na ho paye to itne second wait karke gaana shuru
RESUME_WAIT=300

# ================= NOTICES =================
VC_NOTICE_DEFAULT=1
WELCOME_DEFAULT=1
# Khali = default text. {name} aur {group} use kar sakte ho
WELCOME_TEXT=

# ================= STORAGE UPLOAD SPEED =================
UPLOAD_GAP=3
MAX_UPLOAD_BACKLOG=40

# ================= rebuild_cache.py =================
STOP_AFTER_EMPTY=400
